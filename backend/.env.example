# Standard PostgreSQL connection string for Prisma v5 + Docker Compose
DATABASE_URL="postgresql://user:password@localhost:5432/db?schema=public"

PORT=5000
JWT_SECRET="your_secret_key"

# Optional: fill these in if you want Cloudinary uploads or email notifications
CLOUDINARY_URL="cloudinary://..."
RESEND_API_KEY="re_..."
RECURRENCE_WINDOW_DAYS=30